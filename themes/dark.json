{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#000000",
    "--editor-surface": "#000000",
    "--foreground": "#e6eaf0",
    "--card": "#171717",
    "--card-foreground": "#e6eaf0",
    "--popover": "#171717",
    "--popover-foreground": "#e6eaf0",
    "--primary": "#e6eaf0",
    "--primary-foreground": "#000000",
    "--secondary": "#171717",
    "--secondary-foreground": "#e6eaf0",
    "--muted": "#171717",
    "--muted-foreground": "#949ba6",
    "--accent": "#272727",
    "--accent-foreground": "#e6eaf0",
    "--border": "#171717",
    "--input": "rgba(230, 234, 240, 0.09)",
    "--ring": "#7f8794",
    "--sidebar": "#171717",
    "--sidebar-foreground": "#e6eaf0",
    "--sidebar-primary": "#e6eaf0",
    "--sidebar-primary-foreground": "#000000",
    "--sidebar-accent": "#272727",
    "--sidebar-accent-foreground": "#e6eaf0",
    "--sidebar-border": "#171717",
    "--sidebar-ring": "#7f8794",
    "--worktree-sidebar": "#171717",
    "--worktree-sidebar-foreground": "#e6eaf0",
    "--worktree-sidebar-accent": "#272727",
    "--worktree-sidebar-accent-foreground": "#e6eaf0",
    "--worktree-sidebar-border": "#171717",
    "--worktree-sidebar-ring": "#7f8794",
    "--worktree-sidebar-active": "rgba(230, 234, 240, 0.1)",
    "--worktree-sidebar-active-border": "#3a3f47",
    "--host-badge": "#272727",
    "--host-badge-foreground": "#e6eaf0",
    "--tab-bar": "#171717",
    "--tab-active": "#171717",
    "--tab-active-foreground": "#e6eaf0",
    "--tab-active-indicator": "#e6eaf0",
    "--tab-inactive": "#171717",
    "--tab-inactive-foreground": "#949ba6",
    "--split-divider": "#171717",
    "--split-divider-hover": "#7f8794",
    "--text-link": "#e6eaf0",
    "--chat-user-message": "#171717",
    "--chat-selection": "rgba(230, 234, 240, 0.2)"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#7c8491",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#f1f5f9",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#a3acb9"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.type",
        "support.function"
      ],
      "settings": {
        "foreground": "#f1f5f9"
      }
    },
    {
      "scope": [
        "variable",
        "punctuation"
      ],
      "settings": {
        "foreground": "#e6eaf0"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#f1f5f9",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#e6eaf0",
        "fontStyle": "underline"
      }
    }
  ]
}
